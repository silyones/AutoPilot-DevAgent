# Copy this file to .env and fill in real values before running the project.
#
# Start the full stack (Postgres + Redis + API) with Docker only:
#   docker-compose up --build
#
# Open the UI at http://localhost:8000
# The API container overrides DATABASE_URL and REDIS_URL to use Docker service names.

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token_here

# ── LangChain / LangSmith ─────────────────────────────────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=autopilot_dev

# ── Database (PostgreSQL — Docker) ────────────────────────────────────────────
# Used by the postgres container and docker-compose variable substitution.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=autopilot_dev

# For host-side tools (pgAdmin, DBeaver) connecting to Docker Postgres:
# Host: localhost  Port: 5433  (mapped in docker-compose.yml)
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/autopilot_dev

# ── Redis (Docker) ────────────────────────────────────────────────────────────
# For host-side tools only — the API container uses redis://redis:6379 automatically.
REDIS_URL=redis://localhost:6379

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=development
MAX_FIX_RETRIES=3
