# Copy this file to .env and fill in real values before running the project.

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token_here

# ── LangChain / LangSmith ─────────────────────────────────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=autopilot_dev

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/autopilot_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=development
MAX_FIX_RETRIES=3
